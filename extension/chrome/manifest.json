{
  "manifest_version": 3,
  "name": "Ownix Capture",
  "version": "0.1.0",
  "description": "Send selected browser content to Ownix Intake.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Ownix"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://app.leondev.xyz/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
