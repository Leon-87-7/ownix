FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir flask waitress youtube-transcript-api Pillow

# yt-dlp is deliberately unpinned and installed in its own layer. Pinning it
# freezes site breakage instead of behaviour — extractors rot as sites change,
# and yt-dlp ships fixes within days. `--no-cache-dir` is pip's cache, not
# Docker's, so the layer above would otherwise be reused forever and yt-dlp
# would never actually update.
# Bump YTDLP_REFRESH (or pass --build-arg YTDLP_REFRESH=$(date +%s)) to pull the
# newest yt-dlp without busting the ffmpeg/apt layers. Deployed version is
# visible at GET /health.
ARG YTDLP_REFRESH=1
RUN pip install --no-cache-dir --upgrade yt-dlp

COPY transcript_server.py .

RUN mkdir -p /app/credentials

EXPOSE 5151

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5151/health')" || exit 1

CMD ["python", "transcript_server.py"]
